# Twitch OAuth tokens generated by `npm run twitch:auth` (never commit)
.twitch-tokens.json*

# Studio runtime state (PIDs of processes it started)
.runtime/

.twitch-tokens.broadcaster.json*

# Loyalty events not yet delivered to Core (bot outbox, local runtime data)
.loyalty-outbox.json*
# Twitch alerts not yet answered by the Lab Core (Lab adapter outbox, local runtime data)
.lab-alerts-outbox.json*
# Channel points redemptions not yet answered by Core (bot and Lab adapter outboxes, local runtime data)
.channel-points-outbox.json*
.lab-channel-points-outbox.json*
# Commands V2 Lab chat sends journal (bot executor, local runtime data)
.lab-chat-journal.json*
# Random Ban V2 timeouts journal (bot executor, local runtime data)
.lab-random-ban-journal.json*

# Studio packaging output
apps/studio/desktop/stage/
apps/studio/desktop/release/
# Extension Hosted Test (staging) package output
apps/twitch-extension/release/
# Browser E2E results (Playwright traces / screenshots of failures)
.e2e-results/
