**/dist
**/.env
**/.env.*
!**/.env.example
**/.twitch-tokens*.json
**/*.pem
**/*.key
**/.runtime*
**/.lab-chat-journal*.json
**/.loyalty-outbox*.json
**/*.log
.git
.turbo
**/.turbo
prototypes
graphify-out
apps/studio/desktop/release
apps/studio/desktop/stage
apps/studio/server/test
