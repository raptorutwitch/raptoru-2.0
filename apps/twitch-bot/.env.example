# Copy to .env (git-ignored, never commit it).
# Connects to Twitch only when 'true'.
TWITCH_ENABLED=false
CORE_API_URL=http://127.0.0.1:3000
BOT_SECRET=change-me-bot-secret-min-16-chars

# Twitch application dedicated to Raptoru 2.0 (dev.twitch.tv/console, confidential client,
# OAuth redirect URL http://localhost:3789/callback). Provided manually.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_BROADCASTER_ID=
# Access + refresh tokens are NOT set here: `npm run twitch:auth` writes them to
# apps/twitch-bot/.twitch-tokens.json (git-ignored) and the bot refreshes them automatically.
# TWITCH_TOKEN_FILE=
# TWITCH_REDIRECT_URI=http://localhost:3789/callback

STREAM_SYNC_INTERVAL_MS=60000
# !daily / !streak in chat (scopes user:read:chat user:write:chat).
# NEVER 'true' on the production channel while SAMMI runs the Daily.
DAILY_CHAT_COMMANDS=false
# !solde/!balance/!compte, !give/!trade, !wallet (scopes user:read:chat user:write:chat).
# NEVER 'true' on the production channel before the wallet cutover.
LOYALTY_CHAT_COMMANDS=false
# Shadow presence tracker (scope moderator:read:chatters). No credits, no chat.
PRESENCE_SHADOW=false
