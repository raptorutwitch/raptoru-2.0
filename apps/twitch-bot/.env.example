# Copy to .env (never commit it).
# Must stay unset/false on the production channel while SAMMI runs the Daily.
TWITCH_ENABLED=false
CORE_API_URL=http://127.0.0.1:3000
BOT_SECRET=change-me-bot-secret-min-16-chars
TWITCH_CLIENT_ID=
# User token of the bot account, scopes: user:read:chat user:write:chat
TWITCH_USER_ACCESS_TOKEN=
TWITCH_BOT_USER_ID=
TWITCH_BROADCASTER_ID=
STREAM_SYNC_INTERVAL_MS=60000
