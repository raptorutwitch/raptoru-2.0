{
  "name": "@raptoru/twitch-extension",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node -e \"console.log('Rien \u00e0 construire : l\u2019extension est servie telle quelle. Emballage : npm run package:production | package:staging | package:calibration')\"",
    "test": "vitest run",
    "package": "node scripts/package.mjs",
    "package:production": "node scripts/package.mjs --target production",
    "package:staging": "node scripts/package.mjs --target staging",
    "package:calibration": "node scripts/package.mjs --target calibration",
    "verify:package": "node scripts/verify-package.mjs"
  }
}
