# Copy to .env (never commit it). Dev values only.
PORT=3000
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/raptoru_dev
BOT_SECRET=change-me-bot-secret-min-16-chars
STUDIO_SECRET=change-me-studio-secret-min-16-chars
# Only 'dev-fake' exists before the StreamElements cutover: no real jetons move.
DAILY_CREDIT_PROVIDER=dev-fake
# true = each Daily claim is credited into the Core Wallet (idempotent per claim). Keep false before
# the cutover: claims stay real, zero Wallet write.
DAILY_WALLET_CREDITS=false
# Only for `npm run daily:import-legacy` (read-only on this database).
# LEGACY_DATABASE_URL=
# Loyalty Engine. PREVIEW computes rewards (with breakdown) without any Wallet write.
# The two CREDITS flags write Jetons into the Core wallet: never before the cutover.
LOYALTY_PREVIEW=false
LOYALTY_PASSIVE_CREDITS=false
LOYALTY_EVENT_CREDITS=false
