{
  "name": "@raptoru/core-api",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "db:migrate": "tsx --env-file-if-exists=.env src/scripts/migrate.ts",
    "daily:import-legacy": "tsx --env-file-if-exists=.env src/scripts/import-legacy-daily.ts",
    "test:integration": "vitest run test/postgres.integration.test.ts test/commands-v2.integration.test.ts test/migrate.integration.test.ts",
    "presence:report": "tsx --env-file-if-exists=.env src/scripts/presence-report.ts",
    "loyalty:report": "tsx --env-file-if-exists=.env src/scripts/loyalty-report.ts"
  },
  "dependencies": {
    "@raptoru/schemas": "*",
    "pg": "^8.23.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@types/pg": "^8.23.1"
  }
}
